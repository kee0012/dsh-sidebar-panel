{
  "name": "dsh-sidebar-panel",
  "version": "0.8.3",
  "description": "DSH (DeepSeek Harness) right-side panel plugin: a tab of the shipped right column with overview (context/cost/usage), files (workspace tree + right-click reference/copy/reveal), changes (files written this session) and tools (tool-call details).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "panel",
    "context-window",
    "file-tree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kee0012/dsh-sidebar-panel.git"
  },
  "homepage": "https://github.com/kee0012/dsh-sidebar-panel#readme",
  "bugs": {
    "url": "https://github.com/kee0012/dsh-sidebar-panel/issues"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "//deps": "Harness packages are shared instances of the running host, so they are peer + dev only: a profile-local copy would silently shadow the runtime version. devDependencies keep this checkout self-contained for local development.",
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "gates": "node scripts/gates/run.mjs",
    "check": "node --check src/index.js && node --check client/client.js",
    "test": "node test/unit.test.mjs && node test/smoke.client.mjs",
    "test:unit": "node test/unit.test.mjs",
    "test:smoke": "node test/smoke.client.mjs",
    "verify": "node scripts/build.mjs && node scripts/gates/run.mjs && node test/unit.test.mjs && node test/smoke.client.mjs"
  }
}
